name: Gerar APK Conecta e Vence

on:
  workflow_dispatch:

jobs:
  construir:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar codigo
        uses: actions/checkout@v4

      - name: Encontrar e extrair projeto
        run: |
          mkdir -p projeto_extraido

          ZIP=$(find . -maxdepth 1 -type f -name '*.zip' | head -1)

          if [ -z "$ZIP" ]; then
            echo "ERRO: nenhum arquivo ZIP encontrado."
            exit 1
          fi

          echo "ZIP encontrado: $ZIP"
          unzip -q "$ZIP" -d projeto_extraido

          echo "Arquivos do projeto:"
          find projeto_extraido -maxdepth 5 \( -name settings.gradle -o -name settings.gradle.kts \)

      - name: Configurar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Configurar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Encontrar projeto Android
        id: android
        run: |
          PROJECT=$(find "$GITHUB_WORKSPACE/projeto_extraido" \
            \( -name settings.gradle -o -name settings.gradle.kts \) \
            -print -quit | xargs dirname)

          if [ -z "$PROJECT" ]; then
            echo "ERRO: projeto Android nao encontrado."
            exit 1
          fi

          echo "Projeto Android encontrado em: $PROJECT"
          echo "project=$PROJECT" >> "$GITHUB_OUTPUT"

      - name: Gerar APK
        run: |
          cd "${{ steps.android.outputs.project }}"
          gradle assembleDebug

      - name: Disponibilizar APK
        uses: actions/upload-artifact@v4
        with:
          name: Conecta-Vence-APK
          path: '**/app/build/outputs/apk/debug/*.apk'
          if-no-files-found: error
