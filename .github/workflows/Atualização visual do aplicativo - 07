name: Gerar APK Conecta e Vence

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar codigo
        uses: actions/checkout@v4

      - name: Extrair projeto V77
        run: unzip -q Conecta_Vence_V77_Tela_Inicial_Corrigida.zip

      - name: Configurar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Configurar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Gerar APK
        run: |
          PROJECT=$(find . -name settings.gradle -o -name settings.gradle.kts | head -1 | xargs dirname)
          echo "Projeto encontrado: $PROJECT"
          cd "$PROJECT"
          gradle assembleDebug

      - name: Disponibilizar APK
        uses: actions/upload-artifact@v4
        with:
          name: Conecta-Vence-V77-APK
          path: '**/app/build/outputs/apk/debug/*.apk'
          if-no-files-found: error
